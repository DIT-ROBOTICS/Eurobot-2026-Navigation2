# Eurobot 2026 Navigation Docker Environment Variables
# Copy this file to .env and customize for your setup

# Your user ID (automatically detected, usually don't need to change)
USER_UID=1000

# ROS 2 Domain ID (for network isolation between robots/teams)
# Each robot should have a unique domain ID (0-101)
ROS_DOMAIN_ID=0

# VNC Configuration (only needed for GUI/desktop services)
VNC_PORT=5901
VNC_PASSWORD=ros

# Container naming (usually auto-detected from $USER)
# USER=yourname
